# Ignora tudo
*

# Excetua as pastas desejadas
!hypr/
!hypr/**
!kitty/
!kitty/**
!fastfetch/
!fastfetch/**
!btop/
!btop/**
!quickshell/
!quickshell/**
!fontconfig/
!fontconfig/**
!xdg-desktop-portal/
!xdg-desktop-portal/**
!mpv/
!mpv/**
!donwaztok/
!donwaztok/**
donwaztok/config.json

# Arquivos soltos em .config (end-4)
!starship.toml
!kdeglobals

# Raiz do repo
!.gitignore
!app.lst
!README.md
!install.sh
!.zshrc

# -----------------------------------------------------------------------------
# Re-ignorar dentro das pastas rastreadas (cache, estado, gerados)
# -----------------------------------------------------------------------------
# Python / Quickshell
**/__pycache__/
**/.venv/
**/*.pyc
**/target/

# Cache e logs em qualquer pasta rastreada
**/cache/
**/Cache/
**/*.log
**/*.bak
**/*.old
**/*.tmp
**/*.swp
**/*~
# Built locally by quickshell/donwaztok/scripts/files/fm-rs/build.sh
quickshell/donwaztok/bin/
# Generated by quickshell/donwaztok/scripts/colors/switchwall.sh while a video wallpaper is set
hypr/custom/scripts/__restore_video_wallpaper.sh
