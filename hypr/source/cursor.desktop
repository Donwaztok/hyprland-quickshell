# Hypr / menu launcher (abre o app normalmente). Não registre este arquivo para cursor:// —
# use cursor-url-handler.desktop (veja comentários lá).
#
# Persistir após formatar / instalar sistema:
#   cp ~/.config/hypr/source/cursor.desktop \
#      ~/.config/hypr/source/cursor-url-handler.desktop \
#      ~/.local/share/applications/
#   update-desktop-database ~/.local/share/applications
#   xdg-mime default cursor-url-handler.desktop x-scheme-handler/cursor
#
[Desktop Entry]
Name=Cursor
# Wayland: dead keys ('+c = ç) work. If you need X11, use the line below and cedilla may not work in Cursor.
Exec=/usr/bin/cursor --enable-features=UseOzonePlatform --ozone-platform=wayland --no-sandbox %U
# Exec=env OZONE_PLATFORM=x11 /usr/bin/cursor --enable-features=UseOzonePlatform --ozone-platform=x11 --no-sandbox %U
Terminal=false
Type=Application
# Ícone do pacote Cursor (co.anysphere.cursor.png em /usr/share/pixmaps/)
Icon=co.anysphere.cursor
# Change the class below to "Cursor" when on X11
StartupWMClass=cursor
Categories=Utility;TextEditor;Development;IDE
